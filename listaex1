function Home({ irPara }) {
  const botoes = [
    "Um", "Dois", "Três", "Quatro", "Cinco",
    "Seis", "Sete", "Oito", "Nove", "Dez",
  ];

  return (
    <View style={styles.homeContainer}>
      <Image source={logo} style={{ width: 140, height: 140 }} resizeMode="contain" />
      <Text style={styles.homeTitulo}>HOME</Text>
      <View style={styles.homeGrid}>
        {botoes.map((nome) => (
          <TouchableOpacity
            key={nome}
            style={styles.homeBotao}
            onPress={() => irPara(nome)}
          >
            <Text style={styles.textoBotao}>{nome}</Text>
          </TouchableOpacity>
        ))}
      </View>
    </View>
  );
}

const telas = {
  Um, Dois, Tres, Quatro, Cinco, Seis, Sete, Oito, Nove, Dez,
};

export default function App() {
  const [tela, setTela] = useState("Home");

  if (tela === "Home") return <Home irPara={(nome) => setTela(nome.normalize("NFD").replace(/[\u0300-\u036f]/g, ""))} />;

  const Tela = telas[tela];
  return (
    <View style={{ flex: 1 }}>
      <TouchableOpacity style={styles.voltar} onPress={() => setTela("Home")}>
        <Text style={styles.textoBotao}>Voltar</Text>
      </TouchableOpacity>
      <Tela />
    </View>
  );
}

